{
  "manifest_version": 3,
  "name": "课程学习助手",
  "version": "2.1",
  "description": "自动检测学习时长，满足后点击下一个；遇到任务页面截图给 AI 判断下一步",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "课程学习助手设置"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
